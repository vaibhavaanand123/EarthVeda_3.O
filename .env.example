# Frontend preview works without the backend. Use connected for the full-stack tutorial.
VITE_COMMERCE_MODE=preview
NODE_ENV=development
HOST=127.0.0.1
PORT=8787
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0&directConnection=true
MONGODB_DATABASE=earthveda_dev
UPLOAD_DIR=./data/uploads
STATIC_DIR=./dist
PUBLIC_SITE_URL=http://localhost:5173
APP_SECRET=replace_with_random_secret_generated_using_the_guide
TRUST_PROXY=0
LOG_LEVEL=info
ADMIN_EMAIL=owner@example.test
ADMIN_PASSWORD=
REQUIRE_ADMIN_MFA=false
PAYMENT_PROVIDER=mock
PAYMENT_ACCOUNT_MODE=single
PAYMENT_MODE=test
CHECKOUT_EXPIRES_MINUTES=60
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DE_SECRET_KEY=
STRIPE_DE_WEBHOOK_SECRET=
STRIPE_GB_SECRET_KEY=
STRIPE_GB_WEBHOOK_SECRET=
# Exact UK outward postcodes; blank allows all GB postcodes. Define your London coverage.
GB_POSTCODE_AREAS=
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM="Earthveda Development <shop@example.test>"
MAIL_REPLY_TO=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
ORDER_WEBHOOK_URL=
# Only for the Vite dev proxy. Production should use the same origin.
CORS_ORIGINS=http://localhost:5173
CHECKOUT_RATE_LIMIT=15
VITE_PUBLIC_SITE_URL=http://localhost:5173
VITE_WHATSAPP_NUMBER=
