{
  "name": "earthveda-commerce-js",
  "private": true,
  "version": "6.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:api": "node --watch --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "build": "vite build",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --disable-warning=ExperimentalWarning --test tests/*.test.js",
    "check": "npm run lint && npm run format:check && npm test && npm run test:ui && npm run build",
    "test:ui": "node --disable-warning=ExperimentalWarning --import ./tests/test-env.js --import ./tests/jsx-loader.js --test tests/storefront.ui.js",
    "db:backup": "node --env-file-if-exists=.env server/scripts/backup.js",
    "admin:create": "node --env-file-if-exists=.env server/scripts/createAdmin.js",
    "dev:worker": "node --watch --env-file-if-exists=.env server/worker.js",
    "worker": "node --env-file-if-exists=.env server/worker.js",
    "db:setup": "node --env-file-if-exists=.env server/scripts/setupDatabase.js",
    "test:integration": "node --test tests/mongo.integration.js",
    "test:deployment": "bash tests/deployment.sh",
    "db:migrate:sqlite": "node --env-file-if-exists=.env server/scripts/migrateSqlite.js",
    "admin:mfa-reset": "node --env-file-if-exists=.env server/scripts/resetMfa.js"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "compression": "^1.8.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.468.0",
    "mongodb": "^6.20.0",
    "nodemailer": "^10.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.0",
    "sharp": "^0.35.5",
    "stripe": "^23.0.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.28.2",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^30.1.3",
    "mongodb-memory-server": "^10.2.0",
    "prettier": "^3.4.2",
    "vite": "^6.0.5"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "description": "Earthveda Essentials D2C shop for Germany and the UK: storefront, Stripe checkout, email/WhatsApp notifications and admin."
}
