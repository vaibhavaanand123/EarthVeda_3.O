NODE_ENV=production
HOST=0.0.0.0
PORT=8787
MONGODB_URI=mongodb+srv://APP_USER:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=earthveda_prod
UPLOAD_DIR=/app/data/uploads
STATIC_DIR=/app/dist
PUBLIC_SITE_URL=https://shop.example.com
APP_SECRET=
TRUST_PROXY=1
REQUIRE_ADMIN_MFA=true
ADMIN_EMAIL=
ADMIN_PASSWORD=
PAYMENT_PROVIDER=stripe
# Use single unless Stripe approves your market-specific merchant setup.
PAYMENT_ACCOUNT_MODE=single
# Keep test for staging; change to live only after the release checklist passes.
PAYMENT_MODE=test
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_DE_SECRET_KEY=
STRIPE_DE_WEBHOOK_SECRET=
STRIPE_GB_SECRET_KEY=
STRIPE_GB_WEBHOOK_SECRET=
CHECKOUT_EXPIRES_MINUTES=60
GB_POSTCODE_AREAS=
SMTP_URL=
MAIL_FROM="Earthveda <orders@YOUR_VERIFIED_DOMAIN>"
MAIL_REPLY_TO=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0
ORDER_WEBHOOK_URL=
CORS_ORIGINS=
CHECKOUT_RATE_LIMIT=15
LOG_LEVEL=info
